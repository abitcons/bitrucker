    <add key="CODEX_CLI_ENABLED" value="true" />
    <add key="CODEX_CLI_BINARY" value="C:\Users\Jimran\.vscode\extensions\openai.chatgpt-26.5707.31428-win32-x64\bin\windows-x86_64\codex.exe" />
    <add key="CODEX_CLI_MODEL" value="gpt-5.4-mini" />
    <add key="CODEX_CLI_REASONING_EFFORT" value="low" />
    <add key="CODEX_CLI_ACTIVE_ONLY" value="true" />
    <add key="CODEX_CLI_MAX_CALLS_PER_HOUR" value="1" />
