<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="PYTHONPATH" value="C:\Code\Imran\binance_bot;C:\Code\Imran\binance_bot\src" />
    <add key="WSGI_HANDLER" value="wsgi.application" />
    <add key="WSGI_LOG" value="C:\Code\Imran\binance_bot\runtime\iis-wfastcgi.log" />
    <add key="BOT_ENFORCE_LOCAL_ACTION_AUTH" value="true" />
    <add key="BOT_ALLOW_LOCAL_ACTIONS" value="false" />
    <add key="BOT_TRUST_CF_ACCESS_HEADERS" value="false" />
    <add key="BOT_REQUIRE_CF_ACCESS" value="false" />
    <add key="BOT_AD_USERS_ONLY" value="false" />
    <add key="SAAS_SECURE_COOKIES" value="true" />
    <add key="SAAS_PUBLIC_SIGNUP_ENABLED" value="false" />
    <add key="SAAS_TENANT_ISOLATION_ENABLED" value="true" />
    <add key="BOT_DRY_RUN" value="false" />
    <add key="PRIMARY_EXCHANGE" value="bitget" />
    <add key="BOT_TWAP_DURATION_SECONDS" value="3600" />
    <add key="BOT_FORCE_ONE_HOUR_TWAP" value="true" />
    <add key="BOT_AUTO_DISCOVERY_ENABLED" value="true" />
    <add key="BOT_AUTO_DISCOVERY_INTERVAL_SECONDS" value="3600" />
    <add key="BOT_AUTO_DISCOVERY_SCAN_LIMIT" value="40" />
    <add key="BOT_AUTO_DISCOVERY_MAX_WORKING_PAIRS" value="4" />
